[Unit]
Description=Smart Attendance System — FastAPI Backend
After=network.target postgresql.service

[Service]
User=pi
WorkingDirectory=/home/pi/attendance_backend
EnvironmentFile=/home/pi/attendance_backend/.env
ExecStart=/home/pi/attendance_backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
