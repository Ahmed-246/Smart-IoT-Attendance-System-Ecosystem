<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern Stable Base Theme -->
    <style name="Theme.AttendanceApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/mosul_blue</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Professional Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.AttendanceApp</item>
    </style>
</resources>
